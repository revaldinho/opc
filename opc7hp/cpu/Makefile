# opc7hp/cpu: simulation checks for the pipelined OPC7 CPU (opc7hpcpu.v) and the reference
# opc7hcpu.v (the same machine, one instruction at a time)
#
#   make                 check: run TESTS on CPU and on opc7cpu.v and compare
#                        their STORE/OUT sequences (check.sh)
#   make check-all       the same for all the claude-tests (some take minutes)
#   make trace           compare CPU's retirement trace (registers and flags
#                        after every instruction) with opc7emu.py for TESTS
#   make trace-all       the same for all the claude-tests
#   make hazards         the same for the directed hazard tests in tests/
#                        (generated by tests/gen_hazards.py, and haz_steps by
#                        tests/gen_steps.py: mulstep and divstep)
#   make ints            run tests/haz_int.hex on CPU under random hardware
#                        interrupts (int_check.sh): the emulator has none, so
#                        the STORE/OUT sequence must match an uninterrupted run
#   make waits           the hazard tests and quick claude-tests under random iwait/dwait
#                        (slow memory, wait_check.sh): traces must still match opc7emu.py
#   make CPU=opc7h ...   the reference opc7hcpu.v instead of opc7hpcpu.v
#   make clean
#
# The original OPC7 (opc7cpu.v, its testbench, emulators and assembler) and the claude-tests are in
# ../../opc7 (OPC7 below); a missing test .hex is built there. Several checks can run at once with
# make -j. Synthesis and Fmax figures: ../synthesis.

CPU    ?= opc7hp
TESTS  ?= writefmt cmptest optest optest32
ALLTESTS = cmptest optest optest32 writefmt randtest divtest bittest shifttest p2divtest p2div32test xdivtest multest cmp32test

OPC7    = ../../opc7
TESTDIR = $(OPC7)/claude-tests
HAZGEN   = haz_raw haz_flags haz_jump haz_misc haz_int
HAZTESTS = $(HAZGEN) haz_steps

.PHONY: check check-all trace trace-all hazards ints waits clean
.SECONDARY: $(addprefix tests/,$(addsuffix .hex,$(HAZTESTS)))
.DEFAULT_GOAL := check

check: $(foreach t,$(TESTS),build/$(CPU).$(t).pass)
check-all: $(foreach t,$(ALLTESTS),build/$(CPU).$(t).pass)
trace: $(foreach t,$(TESTS),build/$(CPU).$(t).tracepass)
trace-all: $(foreach t,$(ALLTESTS),build/$(CPU).$(t).tracepass)
hazards: $(foreach t,$(HAZTESTS),build/$(CPU).$(t).hazpass)
ints: tests/haz_int.hex
	./int_check.sh $(CPU)cpu
waits: $(addprefix tests/,$(addsuffix .hex,$(HAZTESTS)))
	./wait_check.sh $(CPU)cpu

build/$(CPU).%.pass: $(TESTDIR)/%.hex $(CPU)cpu.v opc7htb.v check.sh $(OPC7)/opc7cpu.v $(OPC7)/opc7tb.v
	@mkdir -p build
	./check.sh $* $(CPU)cpu > build/$(CPU).$*.check; s=$$?; cat build/$(CPU).$*.check; exit $$s
	@touch $@

build/$(CPU).%.tracepass: $(TESTDIR)/%.hex $(CPU)cpu.v opc7htb.v trace_compare.py $(OPC7)/opc7emu.py
	@mkdir -p build
	./trace_compare.py $* $(CPU)cpu > build/$(CPU).$*.trace; s=$$?; cat build/$(CPU).$*.trace; exit $$s
	@touch $@

build/$(CPU).%.hazpass: tests/%.hex $(CPU)cpu.v opc7htb.v trace_compare.py $(OPC7)/opc7emu.py
	@mkdir -p build
	./trace_compare.py tests/$*.hex $(CPU)cpu > build/$(CPU).$*.haz; s=$$?; cat build/$(CPU).$*.haz; exit $$s
	@touch $@

tests/%.hex: tests/%.s $(OPC7)/opc7asm.py
	python3 $(OPC7)/opc7asm.py -g sparse $< $@ > tests/$*.lst

$(addprefix tests/,$(addsuffix .s,$(HAZGEN))): tests/gen_hazards.py
	python3 tests/gen_hazards.py

tests/haz_steps.s: tests/gen_steps.py
	python3 tests/gen_steps.py

$(TESTDIR)/%.hex:
	$(MAKE) -C $(TESTDIR) $*.hex

clean:
	rm -rf build
