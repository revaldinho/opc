VPATH=..:../../bcpl

ROOT= ../..

# Tests are built the same way as in ../bcpltests (with sial2opc optimizations)
# and their emulator output is compared with <test>.expected, the output of the
# same program run natively under cintsys.
#
#   make              run the tests for ARCH (default opc7)
#   make ARCH=opc6    run the tests that fit in 16 bits on OPC6
#   make check-all    clean, run on OPC6, clean, run on OPC7
#
# Outputs for the two architectures share file names, so run 'make clean' when
# switching ARCH (check-all does this).

ARCH ?= opc7
assembler ?= $(ROOT)/$(ARCH)/$(ARCH)asm.py
emulator  ?= $(ROOT)/$(ARCH)/$(ARCH)emu.py

TESTS_opc6 = cmptest optest writefmt
TESTS_opc7 = cmptest optest optest32 writefmt
TESTS      = $(TESTS_$(ARCH))
TESTSRCS   = $(addsuffix .b,$(TESTS))

.DEFAULT_GOAL := check

include $(ROOT)/bcpl/Makefile_bcpl.inc

.PHONY: check check-all flt-check sial-check clean-extra

check: $(EMUSTDOUTS) flt-check sial-check
	@fail=0; for t in $(TESTS); do \
	  if diff -q $$t.expected $$t.emu.stdout > /dev/null; then echo "PASS $$t ($(ARCH))"; \
	  else echo "FAIL $$t ($(ARCH)): diff $$t.expected $$t.emu.stdout"; fail=1; fi; \
	done; exit $$fail

# flt.b uses floating point, which sial2opc.py must reject with a non-zero exit
flt-check: flt.sial
	@if python3 $(ROOT)/bcpl/sial2opc.py --$(ARCH) -f flt.sial -g $(ROOT)/bcpl/ext_sial.h > /dev/null 2> flt.err; \
	then echo "FAIL flt ($(ARCH)): floating point was not rejected"; exit 1; \
	else echo "PASS flt ($(ARCH)): rejected - `head -1 flt.err`"; fi

# jge0m, mlab and nop are no longer generated by the compiler, so check the
# translation of hand-written SIAL: a conditional jump to X_M7 and the label
sial-check: jge0m_mlab_nop.sial
	@python3 $(ROOT)/bcpl/sial2opc.py --$(ARCH) -n -f jge0m_mlab_nop.sial -g $(ROOT)/bcpl/ext_sial.h > sial-check.s
	@if grep -q -E '^ *pl\.l?mov +pc, *(r0, *)?X_M7' sial-check.s && grep -q '^X_M7:' sial-check.s; \
	then echo "PASS jge0m/mlab/nop ($(ARCH))"; \
	else echo "FAIL jge0m/mlab/nop ($(ARCH)): see sial-check.s"; exit 1; fi

check-all:
	$(MAKE) clean && $(MAKE) ARCH=opc6 check && $(MAKE) clean && $(MAKE) ARCH=opc7 check

clean: clean-extra

clean-extra:
	rm -f flt flt.sial flt.err sial-check.s optest32 optest32.sial
